# Copy to .env.local and fill in. Never commit .env.local.

# Required: Gemini API key from https://aistudio.google.com/apikey
# Server-side only (no NEXT_PUBLIC_ prefix): the browser gets short-lived tokens from /api/token.
GEMINI_API_KEY=

# Required: Supabase project URL and publishable key
# (Supabase dashboard → Project Settings → API Keys; the legacy "anon" key works too).
# These are public by design. Row Level Security keeps each user's data private.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: comma-separated Google account emails allowed to start Live sessions.
# Leave empty to let anyone who signs in use Live (each Live session spends your Gemini quota).
LENSBITE_ALLOWED_EMAILS=

# Optional: Live tokens per user per UTC day (one per connect/reconnect, ~every 10 min). Default 40.
LIVE_TOKENS_PER_DAY=
